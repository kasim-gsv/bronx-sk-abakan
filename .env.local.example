# Скопируйте этот файл в .env.local и заполните значения.
# Без переменных сайт работает: заявки не отправляются, кабинет доступен
# только через тестовый вход (в dev-режиме).

# --- Заявки с сайта → Telegram-бот ---
# 1. Создайте бота у @BotFather, получите токен.
# 2. Напишите своему боту /start, чтобы он мог отправлять вам сообщения.
# 3. Узнайте chat_id: https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Вход в личный кабинет через Telegram ---
# В @BotFather: выберите бота → Login Widget → добавьте Allowed URL
# (адрес сайта и https://<домен>/api/auth/telegram/callback).
# Там же BotFather покажет Client ID и Client Secret.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Необязательно: переопределить redirect_uri
# TELEGRAM_LOGIN_REDIRECT_URI=https://bronx-abakan.ru/api/auth/telegram/callback

# Telegram ID администраторов (через запятую). Такой пользователь при входе
# через Telegram получает доступ к /admin. Свой ID можно узнать у @userinfobot.
# ADMIN_TELEGRAM_IDS=123456789

# --- Сессии ---
# Случайная строка 32+ символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- База данных ---
# По умолчанию ./data/bronx.db (SQLite, встроенный модуль Node).
# DATABASE_PATH=./data/bronx.db

# Тестовый вход в кабинет в production (по умолчанию включён только в dev).
# ALLOW_DEV_LOGIN=1

# Публичный адрес сайта (нужен для canonical, sitemap и OG-тегов).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
